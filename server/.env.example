# Copy to server/.env and fill in credentials. Keep server/.env private.
# Use a comma-separated list to rotate Gemini keys after quota/auth errors.
GEMINI_API_KEYS=replace-with-key-1,replace-with-key-2
ABLEWAY_GEMINI_MODEL=gemini-2.5-flash
ABLEWAY_PROVIDERS=gemini,local,offline
ABLEWAY_PORT=8000
ABLEWAY_HOST=127.0.0.1

# Telegram: create a bot with BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=

# Public URL used in links in Telegram/handoff messages. For local testing:
PUBLIC_BASE_URL=http://localhost:8001
ALERTS_INTERVAL_MINUTES=3

# Set a private password for the tutor handoff console before sharing it.
TUTOR_PASSWORD=

# Optional paths (relative paths are resolved from able_way/).
CHANNELS_DB_PATH=data/channels.db
ACCOMMODATIONS_DB_PATH=data/accommodations.db

# Optional if you run Ollama locally:
ABLEWAY_OLLAMA_URL=http://127.0.0.1:11434
ABLEWAY_OLLAMA_MODEL=gemma3:4b

# Optional shared tutor overrides (leave blank to use built-in tutor):
CORE_ASK_IMPORT=
CORE_ASK_URL=
