# Copy to .env (same folder) and fill in. Everything is optional: both servers start without it.
# Both servers read this one file. Never commit .env: it holds your keys.

# ---------------------------------------------------------------- AI tutor: server/app.py (port 8001)
# Order in which AI providers are tried. Missing keys are skipped; "offline" is always last.
ABLEWAY_PROVIDERS=gemini,local,offline
# Free key from https://aistudio.google.com/apikey . Several keys, comma-separated, are rotated.
GEMINI_API_KEY=
ABLEWAY_GEMINI_MODEL=gemini-2.5-flash
# Mimi's voice. Gemini's free tier allows only a few voice requests a day, so add Azure (below).
# Google Cloud Text-to-Speech also works (Amharic voice am-ET-Wavenet-A; needs billing enabled).
# Without either, the browser's own voice is used: Microsoft Edge has an Amharic voice, Chrome does not.
# Recommended for Amharic: Azure AI Speech (official, free tier F0). One key gives Mimi a natural
# Amharic female voice (am-ET-MekdesNeural) and Amharic + English listening. Create a "Speech"
# resource in the Azure portal, then copy Key 1 and its region (for example westeurope).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Voices are tried in this order; any without a key is skipped.
ABLEWAY_TTS=azure,gemini,google
GOOGLE_TTS_API_KEY=
# Optional local model with no internet: install Ollama, then  ollama pull gemma3:4b
ABLEWAY_OLLAMA_MODEL=gemma3:4b
ABLEWAY_PORT=8001

# ---------------------------------------------------------------- channels: server/main.py (port 8000)

# Telegram bot token from @BotFather. If empty, the bot is skipped with a warning.
TELEGRAM_BOT_TOKEN=

# Shared password for the tutor console at /handoff/console.
# If empty, a random one is generated at startup and printed in the server log.
TUTOR_PASSWORD=

# Public base URL of this server, used in links the bot and SMS send out.
PUBLIC_BASE_URL=http://localhost:8000

# How often the job-alert scheduler runs, in minutes. 0 turns it off.
ALERTS_INTERVAL_MINUTES=3

# Where Telegram, SMS and /lite get answers. server.core_bridge:ask = the real tutor.
# Leave both empty to use the three canned demo answers.
#   CORE_ASK_IMPORT: "package.module:function" called as f(question=, lang=, channel=, simple=)
#   CORE_ASK_URL:    HTTP endpoint that accepts POST {question, lang, channel, simple}
CORE_ASK_IMPORT=server.core_bridge:ask
CORE_ASK_URL=

# Database files (defaults shown).
CHANNELS_DB_PATH=data/channels.db
ACCOMMODATIONS_DB_PATH=data/accommodations.db

# ---------------------------------------------------------------- integration (optional)
# Where the tutor sends "talk to a person" (the help desk, server/main.py). docker-compose sets it.
CHANNELS_URL=http://localhost:8000
# Level 2 webhook: this address receives {"event": "ticket.opened", ...} when a learner asks for a person.
WEBHOOK_URL=
